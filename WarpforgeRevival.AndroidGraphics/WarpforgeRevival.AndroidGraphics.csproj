<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android only: a small loader plugin that picks the graphics system before the game starts drawing. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WarpforgeRevival.AndroidGraphics</AssemblyName>
    <RootNamespace>WarpforgeRevival</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>embedded</DebugType>
    <NoWarn>CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RefsDir Condition="'$(RefsDir)' == ''">$(MSBuildThisFileDirectory)..\refs</RefsDir>
    <AndroidRefs Condition="'$(AndroidRefs)' == ''">$(MSBuildThisFileDirectory)..\refs-android</AndroidRefs>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="$(RefsDir)\net6\*.dll" Private="false" />
    <Reference Include="$(AndroidRefs)\ml\*.dll" Private="false" />
  </ItemGroup>
</Project>
